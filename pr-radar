# ---- config -----------------------------------------------------------------
def local_timezone():
    try:
        return os.path.realpath("/etc/localtime").split("zoneinfo/", 1)[1]
    except IndexError:
        return "UTC"


DEFAULTS = {
    "repos": [],                       # "owner/name" entries; picked in the Repos menu
    "timezone": local_timezone(),
    "work_days": [0, 1, 2, 3, 4],      # Mon-Fri (0 = Monday)
    "work_hours": [8, 19],             # 08:00 <= now < 19:00 in `timezone`
    "poll_seconds": 300,               # how often the app polls GitHub (macOS may stretch this when the app is idle)
    "required_approvals": 2,           # human approvals needed before merge
    "fail_notify_after": 6,            # one notification after this many consecutive failures
}


def apply_config(cfg):
    global REPOS, TZ, WORK_DAYS, WORK_HOURS, POLL_SECONDS, REQUIRED_APPROVALS, FAIL_NOTIFY_AFTER
    REPOS = list(cfg["repos"])
    TZ = ZoneInfo(cfg["timezone"])
    WORK_DAYS = list(cfg["work_days"])
    WORK_HOURS = tuple(cfg["work_hours"])
    POLL_SECONDS = cfg["poll_seconds"]
    REQUIRED_APPROVALS = cfg["required_approvals"]
    FAIL_NOTIFY_AFTER = cfg["fail_notify_after"]


def load_config():
    cfg = dict(DEFAULTS)
    if CONFIG.exists():
        cfg.update(json.loads(CONFIG.read_text()))
    apply_config(cfg)
    return cfg


def save_repos(repos):
    cfg = dict(DEFAULTS)
    if CONFIG.exists():
        cfg.update(json.loads(CONFIG.read_text()))
    cfg["repos"] = repos
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps(cfg, indent=2) + "\n")
    apply_config(cfg)


REPO_RE = re.compile(r"^[\w.-]+/[\w.-]+$")


def check_repos(repos):
    """Problems with the given repos (empty list when all are fine)."""
    problems = []
    for r in repos:
        if not REPO_RE.match(r):
            problems.append(f"{r}: expected owner/name")
        elif gh_run("api", f"repos/{r}", "--silent").returncode:
            problems.append(f"{r}: not accessible with your gh login")
    return problems or ([] if repos else ["enter at least one repo"])


def candidate_repos(selected):
    """Repos to offer: ones you touched recently (newest first), then the rest alphabetically.

    "Touched" = PRs you authored or reviewed; the rest are repos you've contributed to plus your current picks.
    """
    q = """{
      a: search(query: "is:pr author:@me sort:updated-desc", type: ISSUE, first: 50) { nodes { ...R } }
      r: search(query: "is:pr reviewed-by:@me sort:updated-desc", type: ISSUE, first: 50) { nodes { ...R } }
      viewer { repositoriesContributedTo(first: 100, includeUserRepositories: true,
        contributionTypes: [COMMIT, PULL_REQUEST, PULL_REQUEST_REVIEW]) { nodes { nameWithOwner } } }
    }
    fragment R on PullRequest { updatedAt repository { nameWithOwner } }"""
    d = gh_graphql(q)
    recent = {}
    for n in d["a"]["nodes"] + d["r"]["nodes"]:
        if n:
            repo = n["repository"]["nameWithOwner"]
            recent[repo] = max(recent.get(repo, ""), n["updatedAt"])  # ISO timestamps sort as text
    others = {n["nameWithOwner"] for n in d["viewer"]["repositoriesContributedTo"]["nodes"]} | set(selected)
    return (sorted(recent, key=recent.get, reverse=True)
            + sorted(others - set(recent), key=str.lower))


apply_config(DEFAULTS)

PR_FIELDS = """
  number title url isDraft createdAt updatedAt reviewDecision mergeable
  author { login }
  repository { nameWithOwner }
  comments { totalCount }
  latestOpinionatedReviews(first: 50) { nodes { state author { login __typename } } }
  reviewThreads { totalCount }
  commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
"""


def log(msg):
    DATA.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as f:
        f.write(f"{datetime.now().isoformat(timespec='seconds')} {msg}\n")
    if LOG.stat().st_size > 512_000:  # crude rotation
        LOG.replace(LOG.with_suffix(".log.1"))


def gh_bin():
    # GUI and launchd processes get a minimal PATH, so also try the usual Homebrew locations
    return shutil.which("gh") or next(
        (p for p in ("/opt/homebrew/bin/gh", "/usr/local/bin/gh") if os.access(p, os.X_OK)), None)


def gh_run(*args):
    gh = gh_bin()
    if not gh:
        raise RuntimeError("gh not found: install it with `brew install gh`")
    return subprocess.run([gh, *args], capture_output=True, text=True, timeout=60)


def gh_check():
    if gh_run("auth", "status").returncode:
        raise RuntimeError("gh is not logged in: run `gh auth login`")


def gh_graphql(query):
    r = gh_run("api", "graphql", "-f", f"query={query}")
    if r.returncode != 0:
        raise RuntimeError(f"gh failed: {r.stderr.strip() or r.stdout.strip()}")
    out = json.loads(r.stdout)
    if out.get("errors") and not out.get("data"):
        raise RuntimeError(f"graphql errors: {out['errors']}")
    return out["data"]


def norm(n):
    ci = None
    commits = n["commits"]["nodes"]
    if commits and commits[0]["commit"]["statusCheckRollup"]:
        ci = commits[0]["commit"]["statusCheckRollup"]["state"]
    ci = {"SUCCESS": "green", "FAILURE": "red", "ERROR": "red",
          "PENDING": "pending", "EXPECTED": "pending"}.get(ci, "none")
    review = {"APPROVED": "approved", "CHANGES_REQUESTED": "changes"}.get(n["reviewDecision"], "pending")
    return {
        "key": f"{n['repository']['nameWithOwner']}#{n['number']}",
        "repo": n["repository"]["nameWithOwner"], "number": n["number"],
        "title": n["title"], "url": n["url"], "draft": n["isDraft"],
        "author": (n["author"] or {}).get("login", "ghost"),
        "created": n["createdAt"], "updated": n["updatedAt"],
        "review": review, "ci": ci, "mergeable": n["mergeable"],
        "approvals": len({(r["author"] or {}).get("login") for r in n["latestOpinionatedReviews"]["nodes"]
                          if r["state"] == "APPROVED" and r["author"] and r["author"]["__typename"] == "User"
                          and r["author"]["login"] != (n["author"] or {}).get("login")}),
        "comments": n["comments"]["totalCount"] + n["reviewThreads"]["totalCount"],
    }


def add_stacks(mine):
    """Stack membership from GitHub's stacks API (not from branch hierarchy)."""
    for p in mine.values():
        p["stack"] = None
    for repo in sorted({p["repo"] for p in mine.values()}):
        r = gh_run("api", "--paginate", "--slurp", f"repos/{repo}/stacks?per_page=100")
        if r.returncode != 0:  # stack info is cosmetic: don't fail the whole run
            log(f"warn: stacks API failed for {repo}: {r.stderr.strip() or r.stdout.strip()}")
            continue
        for st in (s for page in json.loads(r.stdout) for s in page if s["open"]):
            nums = [x["number"] for x in st["pull_requests"] if x["state"] == "open"]
            if len(nums) < 2:
                continue
            for i, n in enumerate(nums):
                p = mine.get(f"{repo}#{n}")
                if p:
                    p["stack"] = {"pos": i + 1, "size": len(nums), "parent": nums[i - 1] if i else None,
                                  "id": f"{repo}#stack{st['number']}"}


def fetch():
    repos = " ".join(f"repo:{r}" for r in REPOS)
    q = f"""
    fragment PR on PullRequest {{ {PR_FIELDS} }}
    {{
      viewer {{ login }}
      needs: search(query: "{repos} is:pr is:open review-requested:@me -author:@me", type: ISSUE, first: 100) {{ nodes {{ ...PR }} }}
      mine: search(query: "{repos} is:pr is:open author:@me", type: ISSUE, first: 100) {{ nodes {{ ...PR }} }}
    }}"""
    d = gh_graphql(q)
    conv = lambda s: {p["key"]: p for p in (norm(n) for n in d[s]["nodes"] if n)}
    mine = conv("mine")
    add_stacks(mine)
    return d["viewer"]["login"], conv("needs"), mine


def final_states(keys, viewer):
    """For PRs that vanished from the lists: state + whether viewer reviewed."""
    if not keys:
        return {}
    parts = []
    for i, k in enumerate(keys):
        repo, num = k.rsplit("#", 1)
        owner, name = repo.split("/")
        parts.append(f'p{i}: repository(owner:"{owner}", name:"{name}") {{ pullRequest(number:{int(num)}) '
                     f'{{ state reviews(last:100) {{ nodes {{ author {{ login }} }} }} }} }}')
    d = gh_graphql("{" + " ".join(parts) + "}")
    out = {}
    for i, k in enumerate(keys):
        pr = (d.get(f"p{i}") or {}).get("pullRequest")
        if pr:
            out[k] = {"state": pr["state"].lower(),
                      "reviewed": any((r["author"] or {}).get("login") == viewer for r in pr["reviews"]["nodes"])}
    return out


def diff(prev, needs, mine, viewer):
    """Return list of (title, message, url)."""
    ev = []
    pn, pm = prev["needs_review"], prev["mine"]
    short = lambda p: f"{p['repo'].split('/')[1]}#{p['number']}: {p['title']}"

    for k, p in needs.items():
        if k not in pn:
            ev.append(("Review requested", f"{short(p)} (by {p['author']})", p["url"]))

    for k, p in mine.items():
        o = pm.get(k)
        if not o:
            continue
        if p["review"] != o["review"] and p["review"] == "changes":
            ev.append(("Changes requested", short(p), p["url"]))
        if p["approvals"] > o.get("approvals", p["approvals"]):
            ev.append((f"Approved ({p['approvals']}/{REQUIRED_APPROVALS})", short(p), p["url"]))
        if p["ci"] != o["ci"]:
            if p["ci"] == "red":
                ev.append(("CI failed", short(p), p["url"]))
            elif p["ci"] == "green" and o["ci"] in ("red", "pending"):
                ev.append(("CI passed", short(p), p["url"]))
        if p["mergeable"] == "CONFLICTING" and o["mergeable"] == "MERGEABLE":  # UNKNOWN is transient
            ev.append(("Merge conflict", short(p), p["url"]))
        if p["comments"] > o["comments"]:
            n = p["comments"] - o["comments"]
            ev.append(("New comments", f"{n} new on {short(p)}", p["url"]))

    gone = [k for k in list(pn) + list(pm) if k not in needs and k not in mine]
    states = final_states(gone, viewer)
    for k in gone:
        p, st = (pn.get(k) or pm.get(k)), states.get(k)
        if not st:
            continue
        if st["state"] in ("merged", "closed"):
            ev.append((f"PR {st['state']}", short(p), p["url"]))
        elif k in pn and not st["reviewed"]:  # still open, request withdrawn (not just fulfilled by me)
            ev.append(("Review request removed", short(p), p["url"]))
    return ev


NATIVE = None  # set by the app when it can post notifications itself


def setup_native_notifications(delegate):
    """Post notifications as PR Radar itself (needs the app bundle's identity). Returns the post function or None."""
    try:
        import UserNotifications as un
    except ImportError:
        return None
    center = un.UNUserNotificationCenter.currentNotificationCenter()
    center.setDelegate_(delegate)  # before launch finishes, or clicks that cold-start the app are dropped

    def answered(granted, err):
        log(f"notification permission: {'granted' if granted else f'denied ({err})'}")
        global NATIVE
        NATIVE = post if granted else None  # denied: fall back to the helper tools
        welcome = DATA / "welcome-sent"
        if granted and not welcome.exists():  # once, so a new user sees where notifications come from
            welcome.touch()
            post("Notifications are on", "Review requests, approvals, CI and comments will show up here.", "welcome")

    def post(title, msg, ident):
        c = un.UNMutableNotificationContent.alloc().init()
        c.setTitle_("PR Radar")
        c.setSubtitle_(title)
        c.setBody_(msg)
        center.addNotificationRequest_withCompletionHandler_(
            un.UNNotificationRequest.requestWithIdentifier_content_trigger_(ident, c, None),  # same PR: replace
            lambda err: err and log(f"warn: notification failed: {err}"))

    center.requestAuthorizationWithOptions_completionHandler_(
        un.UNAuthorizationOptionAlert | un.UNAuthorizationOptionSound, answered)
    return post


def notify(title, msg, url):
    if NATIVE:
        return NATIVE(title, msg, url)
    tn = shutil.which("terminal-notifier") or next(
        (p for p in ("/opt/homebrew/bin/terminal-notifier", "/usr/local/bin/terminal-notifier")
         if os.access(p, os.X_OK)), None)
    if tn:
        cmd = [tn, "-title", "PR Radar", "-subtitle", title, "-message", msg, "-open", url, "-group", url]
    else:
        cmd = ["osascript", "-e",
               "on run argv\ndisplay notification (item 1 of argv) with title \"PR Radar\" subtitle (item 2 of argv)\nend run",
               msg, title]
    subprocess.run(cmd, capture_output=True, timeout=15)


